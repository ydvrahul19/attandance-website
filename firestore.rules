rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function okStr(v, max) { return v is string && v.size() <= max; }
    function validProfile(d) {
      return okStr(d.name, 60) && d.name.size() > 0
        && (!('photo' in d) || okStr(d.photo, 150000))
        && (!('dob' in d) || okStr(d.dob, 10))
        && (!('gender' in d) || okStr(d.gender, 20))
        && (!('email' in d) || okStr(d.email, 100))
        && (!('phone' in d) || okStr(d.phone, 25))
        && (!('address' in d) || okStr(d.address, 250))
        && (!('emergency' in d) || okStr(d.emergency, 120));
    }

    // Profiles: you can read your own, admin can read all.
    // You may edit only your own contact details and photo. Role, ID and joining date are locked.
    // Accounts are created with `npm run create-users`.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['photo', 'name', 'dob', 'gender', 'email', 'phone', 'address', 'emergency'])
        && validProfile(request.resource.data);
    }

    // Many sessions per user per day, id = "<uid>_<yyyy-mm-dd>_<session number>"
    // (older records from before this change have the id "<uid>_<yyyy-mm-dd>" and count as session 1)
    function attPath(id) { return /databases/$(database)/documents/attendance/$(id); }

    // A new session may start only when the one before it has been finished
    function previousFinished(uid, date, n) {
      return (n == 1 && !exists(attPath(uid + '_' + date)))
        || (n > 1 && exists(attPath(uid + '_' + date + '_' + string(n - 1)))
                  && get(attPath(uid + '_' + date + '_' + string(n - 1))).data.outAt != null)
        || (n == 2 && exists(attPath(uid + '_' + date))
                  && get(attPath(uid + '_' + date)).data.outAt != null);
    }

    match /attendance/{recId} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());

      // Check in: only for yourself, time set by the server clock
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.session is int
        && request.resource.data.session >= 1 && request.resource.data.session <= 20
        && recId == request.auth.uid + '_' + request.resource.data.date + '_' + string(request.resource.data.session)
        && request.resource.data.inAt == request.time
        && request.resource.data.outAt == null
        && previousFinished(request.auth.uid, request.resource.data.date, request.resource.data.session);

      // Check out: only your own open record, time set by the server clock
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.outAt == null
        && request.resource.data.outAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'outAt', 'customers', 'visitors', 'notes']);

      allow delete: if false;
    }
  }
}
